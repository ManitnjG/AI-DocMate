OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Provision one unique token per user. Comma-separated; never put provider keys here.
DOCMATE_ACCESS_TOKENS=
# Enable customer sessions only after configuring a fresh server-only signing secret.
DOCMATE_PUBLIC_SESSIONS=false
DOCMATE_SESSION_SECRET=
DOCMATE_DAILY_REQUESTS=100
DOCMATE_QUOTA_DB=/tmp/docmate-quota.sqlite3
